<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="VieDon.App.Pages.RequesterHistoryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:VieDon.App.Localization"
    xmlns:vm="clr-namespace:VieDon.App.ViewModels"
    x:DataType="vm:RequesterHistoryViewModel"
    Title="{loc:Tr 'Historique'}"
    Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <DataTemplate x:Key="FilterChipTemplate" x:DataType="vm:ChipOption">
            <Button Text="{Binding DisplayText, Converter={x:Static loc:TrConverter.Instance}}" Command="{Binding SelectCommand}"
                    Style="{StaticResource ChipButton}" FlexLayout.Grow="1" Margin="3,0"
                    SemanticProperties.Description="{Binding Description, Converter={x:Static loc:TrConverter.Instance}}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PrimaireLight}, Dark={StaticResource PrimaireDark}}" />
                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SurAccentLight}, Dark={StaticResource SurAccentDark}}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
        </DataTemplate>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="16,16,16,24" Spacing="24">

            <Label Text="{loc:Tr 'Historique des alertes'}" Style="{StaticResource Titre}" />
            <Label Text="{Binding SummaryText, Converter={x:Static loc:TrConverter.Instance}}" Style="{StaticResource Legende}" />

            <VerticalStackLayout Spacing="8">
                <Label Text="{loc:Tr 'Filtrer par statut'}" Style="{StaticResource Legende}" />
                <FlexLayout BindableLayout.ItemsSource="{Binding Filters}"
                            BindableLayout.ItemTemplate="{StaticResource FilterChipTemplate}"
                            Direction="Row" Wrap="Wrap" JustifyContent="SpaceBetween" />
            </VerticalStackLayout>

            <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"
                               SemanticProperties.Description="{loc:Tr 'Chargement en cours'}" />

            <Border Style="{StaticResource Card}" IsVisible="{Binding HasError}" Stroke="{AppThemeBinding Light={StaticResource ErreurLight}, Dark={StaticResource ErreurDark}}" StrokeThickness="2">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding ErrorDisplay, Converter={x:Static loc:TrConverter.Instance}}" TextColor="{AppThemeBinding Light={StaticResource ErreurLight}, Dark={StaticResource ErreurDark}}" />
                    <Button Text="{loc:Tr 'Réessayer'}" Style="{StaticResource SecondaryButton}" Command="{Binding LoadCommand}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}" IsVisible="{Binding ShowEmpty}">
                <Label Text="{Binding EmptyText, Converter={x:Static loc:TrConverter.Instance}}" />
            </Border>

            <VerticalStackLayout Spacing="16" BindableLayout.ItemsSource="{Binding Items}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:RequesterAlertItemViewModel">
                        <Border Style="{StaticResource Card}">
                            <VerticalStackLayout Spacing="8">
                                <Border Style="{StaticResource Badge}" IsVisible="{Binding IsCritical}" Stroke="{AppThemeBinding Light={StaticResource PrimaireLight}, Dark={StaticResource PrimaireDark}}">
                                    <Label Text="{Binding UrgencyLabel, Converter={x:Static loc:TrConverter.Instance}}" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource PrimaireLight}, Dark={StaticResource PrimaireDark}}" />
                                </Border>
                                <Border Style="{StaticResource Badge}" IsVisible="{Binding IsUrgent}" Stroke="{AppThemeBinding Light={StaticResource AvertissementLight}, Dark={StaticResource AvertissementDark}}">
                                    <Label Text="{Binding UrgencyLabel, Converter={x:Static loc:TrConverter.Instance}}" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource AvertissementLight}, Dark={StaticResource AvertissementDark}}" />
                                </Border>
                                <Border Style="{StaticResource Badge}" IsVisible="{Binding IsNormal}" Stroke="{AppThemeBinding Light={StaticResource SecondaireLight}, Dark={StaticResource SecondaireDark}}">
                                    <Label Text="{Binding UrgencyLabel, Converter={x:Static loc:TrConverter.Instance}}" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource SecondaireLight}, Dark={StaticResource SecondaireDark}}" />
                                </Border>
                                <Label Text="{Binding GroupLine, Converter={x:Static loc:TrConverter.Instance}}" Style="{StaticResource Section}" />
                                <Label Text="{Binding PlaceName, Converter={x:Static loc:TrConverter.Instance}}" />
                                <Label Text="{Binding DateText, Converter={x:Static loc:TrConverter.Instance}}" Style="{StaticResource Legende}" />
                                <Label Text="{Binding CountersText, Converter={x:Static loc:TrConverter.Instance}}" Style="{StaticResource Legende}" />
                                <Label Text="{Binding StatusText, Converter={x:Static loc:TrConverter.Instance}}" FontAttributes="Bold" />
                                <Button Text="{loc:Tr 'Voir le détail'}" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding OpenCommand}" SemanticProperties.Description="{Binding ButtonDescription, Converter={x:Static loc:TrConverter.Instance}}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
