<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="VieDon.App.Pages.PlaceholderPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:VieDon.App.Localization"
    Shell.NavBarIsVisible="False">
    <VerticalStackLayout Padding="16" VerticalOptions="Center" Spacing="8">
        <Label Text="{loc:Tr 'Écran en construction'}" Style="{StaticResource Titre}" HorizontalTextAlignment="Center" />
        <Label Text="{loc:Tr 'Cet écran sera ajouté dans une prochaine étape.'}" Style="{StaticResource Legende}" HorizontalTextAlignment="Center" />
    </VerticalStackLayout>
</ContentPage>
