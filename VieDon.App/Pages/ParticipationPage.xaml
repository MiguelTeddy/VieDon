<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="VieDon.App.Pages.ParticipationPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:VieDon.App.ViewModels"
    x:DataType="vm:ParticipationViewModel"
    Title="Ton rendez-vous">

    <ScrollView>
        <VerticalStackLayout Padding="16,16,16,24" Spacing="16">

            <Border Style="{StaticResource Card}"
                    Stroke="{AppThemeBinding Light={StaticResource SuccesLight}, Dark={StaticResource SuccesDark}}"
                    StrokeThickness="2">
                <Label Text="✓ Merci ! Ta venue est confirmée" Style="{StaticResource Section}" />
            </Border>

            <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErreurLabel}" />

            <VerticalStackLayout Spacing="16" IsVisible="{Binding IsLoaded}">

                <!-- Code à présenter au centre (le QR code sera ajouté avec une bibliothèque dédiée) -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Label Text="Ton code" Style="{StaticResource Legende}" HorizontalTextAlignment="Center" />
                        <Label Text="{Binding Code}" Style="{StaticResource Display}" HorizontalTextAlignment="Center"
                               SemanticProperties.Description="{Binding Code, StringFormat='Ton code : {0}'}" />
                        <Label Text="{Binding CodeHint}" Style="{StaticResource Legende}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Spacing="4">
                    <Label Text="{Binding EstablishmentName}" FontAttributes="Bold" />
                    <Label Text="{Binding Address}" Style="{StaticResource Legende}" />
                </VerticalStackLayout>
                <Label Text="{Binding DeadlineText}" />
                <Label Text="{Binding ContactText}" Style="{StaticResource Legende}" />

                <Button Text="Itinéraire" Command="{Binding DirectionsCommand}" />
                <Button Text="Je ne peux plus venir" Style="{StaticResource TextButton}"
                        TextColor="{AppThemeBinding Light={StaticResource ErreurLight}, Dark={StaticResource ErreurDark}}"
                        Command="{Binding CancelParticipationCommand}" />
            </VerticalStackLayout>

            <Button Text="Retour à l'accueil" Style="{StaticResource TextButton}" Command="{Binding BackHomeCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
