<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="VieDon.App.Pages.WelcomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:VieDon.App.ViewModels"
    x:DataType="vm:WelcomeViewModel"
    Title="Bienvenue"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="16,16,16,24" Spacing="24">

            <!-- Choix de la langue (localisation à brancher) -->
            <HorizontalStackLayout HorizontalOptions="End" Spacing="8">
                <Button Text="Français" Style="{StaticResource ChipButton}" WidthRequest="104" HeightRequest="48" MinimumHeightRequest="48"
                        Command="{Binding SetLanguageCommand}" CommandParameter="fr"
                        SemanticProperties.Description="Choisir le français">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding SelectedLanguage}" Value="fr">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SecondaireLight}, Dark={StaticResource SecondaireDark}}" />
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SurAccentLight}, Dark={StaticResource SurAccentDark}}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Text="English" Style="{StaticResource ChipButton}" WidthRequest="104" HeightRequest="48" MinimumHeightRequest="48"
                        Command="{Binding SetLanguageCommand}" CommandParameter="en"
                        SemanticProperties.Description="Choose English">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding SelectedLanguage}" Value="en">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SecondaireLight}, Dark={StaticResource SecondaireDark}}" />
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SurAccentLight}, Dark={StaticResource SurAccentDark}}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </HorizontalStackLayout>

            <!-- Logo : goutte dessinée (carré arrondi pivoté) + nom -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="16" Margin="0,24,0,0">
                <Border WidthRequest="36" HeightRequest="36" Rotation="45" VerticalOptions="Center"
                        StrokeThickness="0" StrokeShape="RoundRectangle 0,18,18,18"
                        BackgroundColor="{AppThemeBinding Light={StaticResource PrimaireLight}, Dark={StaticResource PrimaireDark}}"
                        AutomationProperties.IsInAccessibleTree="False" />
                <Label Text="VieDon" Style="{StaticResource Display}" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Label Text="Un donneur compatible, près de toi, en quelques minutes."
                   Style="{StaticResource Titre}" HorizontalTextAlignment="Center" />

            <!-- Trois promesses -->
            <VerticalStackLayout Spacing="16">
                <Grid ColumnDefinitions="32,*" ColumnSpacing="8">
                    <Label Text="✓" FontAttributes="Bold" HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light={StaticResource SuccesLight}, Dark={StaticResource SuccesDark}}"
                           AutomationProperties.IsInAccessibleTree="False" />
                    <Label Grid.Column="1" Text="Don volontaire et gratuit" />
                </Grid>
                <Grid ColumnDefinitions="32,*" ColumnSpacing="8">
                    <Label Text="✓" FontAttributes="Bold" HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light={StaticResource SuccesLight}, Dark={StaticResource SuccesDark}}"
                           AutomationProperties.IsInAccessibleTree="False" />
                    <Label Grid.Column="1" Text="Aucune décision médicale prise par l'appli" />
                </Grid>
                <Grid ColumnDefinitions="32,*" ColumnSpacing="8">
                    <Label Text="✓" FontAttributes="Bold" HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light={StaticResource SuccesLight}, Dark={StaticResource SuccesDark}}"
                           AutomationProperties.IsInAccessibleTree="False" />
                    <Label Grid.Column="1" Text="Aucun nom ni diagnostic du patient" />
                </Grid>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="16" Margin="0,16,0,0">
                <Button Text="Je veux donner mon sang" Command="{Binding ChooseDonorCommand}" />
                <Button Text="Je cherche un donneur" Style="{StaticResource SecondaryButton}" Command="{Binding ChooseRequesterCommand}" />
                <Button Text="J'ai déjà un compte" Style="{StaticResource TextButton}" Command="{Binding HaveAccountCommand}" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
