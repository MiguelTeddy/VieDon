<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Charte VieDon (cahier des charges 7.2). Contrastes calculés selon WCAG.
         Contour corrigé après audit : #757575 (clair, 4,61:1) et #8A8A8A (sombre, 5,43:1) pour les composants (3:1 requis). -->
    <Color x:Key="PrimaireLight">#C62828</Color>
    <Color x:Key="PrimaireDark">#EF5350</Color>
    <Color x:Key="SecondaireLight">#1565C0</Color>
    <Color x:Key="SecondaireDark">#64B5F6</Color>
    <Color x:Key="SuccesLight">#2E7D32</Color>
    <Color x:Key="SuccesDark">#81C784</Color>
    <Color x:Key="AvertissementLight">#A84300</Color>
    <Color x:Key="AvertissementDark">#FFB74D</Color>
    <Color x:Key="ErreurLight">#B3261E</Color>
    <Color x:Key="ErreurDark">#EF9A9A</Color>
    <Color x:Key="TexteLight">#212121</Color>
    <Color x:Key="TexteDark">#EDEDED</Color>
    <Color x:Key="TexteSecLight">#616161</Color>
    <Color x:Key="TexteSecDark">#A0A0A0</Color>
    <Color x:Key="FondLight">#FFFFFF</Color>
    <Color x:Key="FondDark">#121212</Color>
    <Color x:Key="SurfaceLight">#F5F5F5</Color>
    <Color x:Key="SurfaceDark">#1E1E1E</Color>
    <Color x:Key="ContourLight">#757575</Color>
    <Color x:Key="ContourDark">#8A8A8A</Color>
    <!-- Texte posé sur une couleur d'accent pleine -->
    <Color x:Key="SurAccentLight">#FFFFFF</Color>
    <Color x:Key="SurAccentDark">#121212</Color>
</ResourceDictionary>
